    def 'should mix channels'() {
        when:
        def result = runScript('''
            c1 = channel.of( 1,2,3 )
            c2 = channel.of( 'a','b' )
            c3 = channel.value( 'z' )
            c1.mix(c2, c3).collect()
            ''').val

        then:
        1 in result
        2 in result
        3 in result
        'a' in result
        'b' in result
        'z' in result
        !('c' in result)

    }
