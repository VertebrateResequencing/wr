@@ -0,0 +1,121 @@
+package jobqueue
+
+// Diagnostic build only (1g.5 bugfix): traces wal batch syncs, fold
+// commits, add writes and reservation waits to tab-separated files in
+// $WR_DIAG_TRACE (a local directory), and WR_DIAG_NOFOLD=1 skips every fold.
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+	"time"
+
+	"github.com/VertebrateResequencing/wr/jobqueue/wal"
+	bolt "go.etcd.io/bbolt"
+)
+
+var (
+	diagCh      chan string                                 //nolint:gochecknoglobals
+	diagDropped atomic.Uint64                               //nolint:gochecknoglobals
+	diagNoFold  = os.Getenv("WR_DIAG_NOFOLD") == "1"        //nolint:gochecknoglobals
+	diagNoHistBackup = os.Getenv("WR_DIAG_NOHISTBACKUP") == "1" //nolint:gochecknoglobals
+)
+
+func init() { //nolint:gochecknoinits
+	dir := os.Getenv("WR_DIAG_TRACE")
+	if dir == "" || len(os.Args) < 3 || os.Args[1] != "manager" || os.Args[2] != "start" {
+		return
+	}
+
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return
+	}
+
+	f, err := os.Create(filepath.Join(dir, fmt.Sprintf("trace-%d.tsv", os.Getpid())))
+	if err != nil {
+		return
+	}
+
+	diagCh = make(chan string, 1<<16)
+
+	go func() {
+		bw := bufio.NewWriterSize(f, 1<<20)
+		t := time.NewTicker(time.Second)
+
+		for {
+			select {
+			case s := <-diagCh:
+				bw.WriteString(s) //nolint:errcheck
+			case <-t.C:
+				if d := diagDropped.Swap(0); d > 0 {
+					fmt.Fprintf(bw, "dropped\t%d\t%d\n", time.Now().UnixNano(), d)
+				}
+
+				bw.Flush() //nolint:errcheck
+			}
+		}
+	}()
+
+	wal.DiagFinishHook = func(start time.Time, took time.Duration, queued int) {
+		if took > time.Millisecond {
+			diagEmit(fmt.Sprintf("finish\t%d\t%d\t%d\n", start.UnixNano(), took, queued))
+		}
+	}
+
+	wal.DiagSyncHook = func(start time.Time, write, sync time.Duration, bytes, records int) {
+		diagEmit(fmt.Sprintf("sync\t%d\t%d\t%d\t%d\t%d\n", start.UnixNano(), write, sync, bytes, records))
+	}
+}
+
+func diagLockWait(start time.Time, n int) {
+	if d := time.Since(start); d > time.Millisecond {
+		diagEmit(fmt.Sprintf("applylock\t%d\t%d\t%d\n", start.UnixNano(), d, n))
+	}
+}
+
+func diagEmit(s string) {
+	if diagCh == nil {
+		return
+	}
+
+	select {
+	case diagCh <- s:
+	default:
+		diagDropped.Add(1)
+	}
+}
+
+func diagFold(db *bolt.DB, asked, begun time.Time, items int, before bolt.Stats) {
+	if diagCh == nil {
+		return
+	}
+
+	end := time.Now()
+	after := db.Stats()
+	d := after.TxStats.Sub(&before.TxStats)
+
+	var size int64
+	if fi, err := os.Stat(db.Path()); err == nil {
+		size = fi.Size()
+	}
+
+	diagEmit(fmt.Sprintf("fold\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\n", asked.UnixNano(), begun.UnixNano(),
+		end.UnixNano(), items, d.GetWrite(), d.GetWriteTime(), d.GetSpillTime(), d.GetPageAlloc(),
+		after.FreePageN, after.PendingPageN, after.FreelistInuse, size))
+}
+
+func diagReserve(waited time.Duration) {
+	diagEmit(fmt.Sprintf("resv\t%d\t%d\n", time.Now().UnixNano(), waited))
+}
+
+func diagAdd(bytes, blocks int) {
+	diagEmit(fmt.Sprintf("add\t%d\t%d\t%d\n", time.Now().UnixNano(), bytes, blocks))
+}
+
+func diagHist(start time.Time, db *bolt.DB) {
+	var size int64
+	_ = db.View(func(tx *bolt.Tx) error { size = tx.Size(); return nil })
+	diagEmit(fmt.Sprintf("hist\t%d\t%d\t%d\n", start.UnixNano(), time.Now().UnixNano(), size))
+}
