{
  "$id": "urn:wr:nextflow-conformance:schema:1:bindings.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence_kind": {
      "enum": [
        "foundation",
        "oracle",
        "differential",
        "wr-runtime"
      ],
      "type": "string",
      "x-wr-field-rules": [
        "uat-kind"
      ]
    },
    "id": {
      "pattern": "^[A-Z][A-Z0-9_]*(?![\\s\\S])",
      "type": "string",
      "x-wr-field-rules": [
        "id"
      ]
    },
    "package": {
      "allOf": [
        {
          "pattern": "^github\\.com/VertebrateResequencing/wr(?:/|(?![\\s\\S]))"
        },
        {
          "pattern": "^(?!\\.{1,2}(?:/|(?![\\s\\S])))[^/\\\\\\u0000]+(?:/(?!\\.{1,2}(?:/|(?![\\s\\S])))[^/\\\\\\u0000]+)*(?![\\s\\S])"
        }
      ],
      "type": "string",
      "x-wr-field-rules": [
        "package"
      ]
    },
    "schema": {
      "const": 1,
      "maximum": 9223372036854775807,
      "minimum": -9223372036854775808,
      "type": "integer",
      "x-wr-field-rules": [
        "one"
      ]
    },
    "source_files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer",
            "x-wr-field-rules": [
              "nonnegative"
            ]
          },
          "path": {
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}(?:/|(?![\\s\\S])))[^/\\\\\\u0000]+(?:/(?!\\.{1,2}(?:/|(?![\\s\\S])))[^/\\\\\\u0000]+)*(?![\\s\\S])",
            "type": "string",
            "x-wr-field-rules": [
              "path"
            ]
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
            "type": "string",
            "x-wr-field-rules": [
              "hash"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "x-wr-field-rules": [
        "nonempty"
      ]
    },
    "test": {
      "pattern": "^TestUAT_[A-Z0-9_]+(?![\\s\\S])",
      "type": "string",
      "x-wr-field-rules": [
        "test"
      ]
    },
    "uat_id": {
      "pattern": "^[A-Z][A-Z0-9_]*(?![\\s\\S])",
      "type": "string",
      "x-wr-field-rules": [
        "id"
      ],
      "x-wr-reference": "uats"
    }
  },
  "required": [
    "schema",
    "id",
    "uat_id",
    "package",
    "test",
    "source_files",
    "evidence_kind"
  ],
  "title": "bindings version 1",
  "type": "object",
  "x-wr-record-rules": [
    "decodeRecord: UTF-8; final newline; no duplicate keys; no trailing value",
    "loadRecordFile/checkNested: sorted unique IDs and unique paths, environment keys and result UAT IDs",
    "checkRules: sorted unique identifier/text/index arrays; integer JSON lexical form",
    "checkReferences: typed references resolve within the same target revision",
    "checkSourceSpans: locked source file, matching hash, ordered span within byte bounds",
    "checkBindingRelation: evidence kind matches referenced UAT"
  ]
}
